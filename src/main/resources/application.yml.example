spring:
  mongodb:
    uri: ${MONGODB_URI:mongodb+srv://<username>:<password>@<cluster-url>/mydata?retryWrites=true&w=majority}

server:
  port: ${PORT:8080}

external:
  report-api:
    base-url: ${REPORT_API_BASE_URL:http://localhost:8000}

app:
  cors:
    allowed-origins: ${APP_CORS_ORIGINS:http://localhost:5173}
